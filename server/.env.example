# Copy this file to .env for local development.
# On Railway, set these as environment variables in the project instead of using a file.

# The same Postgres connection string your Knox-bot Railway project already uses.
# On Railway this is usually available as DATABASE_URL automatically if the app
# is in the same project as the database.
DATABASE_URL=postgres://user:password@host:port/dbname

# Discord OAuth2 app credentials.
# Create/reuse an app at https://discord.com/developers/applications
# Add this exact redirect URL under OAuth2 > Redirects:
#   http://localhost:3001/auth/discord/callback   (for local dev)
#   https://your-app.up.railway.app/auth/discord/callback   (for production)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Comma-separated Discord user IDs allowed to log in (just you, for now).
# Right-click your name in Discord with Developer Mode on to copy your ID.
ALLOWED_DISCORD_IDS=

# A long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL of the deployed frontend, for CORS. In local dev this is the Vite dev server.
CLIENT_URL=http://localhost:5173

# Knox-bot's own Railway URL (the one its spotifyHttpServer listens on) and a
# shared secret that must match INTERNAL_API_SECRET set on Knox-bot itself.
# This is how the chat room talks to Knox's actual brain instead of a copy of it.
KNOX_BOT_URL=https://your-knox-bot.up.railway.app
INTERNAL_API_SECRET=

PORT=3001
